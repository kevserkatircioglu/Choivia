/* Default plant palette for custom hobbies. */
:root {
  --plant-bg: #f0f5e9;
  --plant-stem: #56835c;
  --plant-leaf: #83b777;
  --plant-leaf-light: #a2c98c;
  --plant-leaf-mid: #73a96c;
  --plant-leaf-pale: #96c483;
  --plant-leaf-top: #78ad70;
  --plant-leaf-edge: #56835c;
  --plant-leaf-edge-dark: #4e7e56;
  --plant-leaf-vein: #d9eacd;
}

/* Phase 4 — hobby garden cards */
.hb-cards {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr));
  gap: 16px;
}

.hb-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: stretch;
  gap: 12px;
  padding: 16px;
  background: linear-gradient(145deg, #fffefa, var(--hb-soft));
  border-color: var(--hb-line);
  box-shadow: 0 8px 24px rgba(40, 60, 45, .045);
}

.hb-card-link {
  display: grid;
  grid-template-columns: 104px minmax(0, 1fr);
  align-items: center;
  gap: 14px;
  width: 100%;
}

.hb-card-garden-art {
  display: grid;
  place-items: center;
  align-content: center;
  gap: 2px;
  min-height: 136px;
  border-radius: 18px;
  background: var(--plant-bg, #f0f5e9);
  overflow: hidden;
}

.hb-card-plant {
  width: 88px;
  height: 88px;
  filter: drop-shadow(0 5px 5px rgba(69, 105, 65, .10));
}

.hb-card-garden-art small {
  color: var(--hb-green);
  font-size: 12px;
  font-weight: 800;
}

.hb-card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.hb-card-title .hb-emoji {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 10px;
  flex: none;
  background: var(--hb-soft);
}

.hb-card-title strong {
  min-width: 0;
  overflow-wrap: anywhere;
}

.hb-card .hb-checkin {
  width: 100%;
}

.hb-template[data-hobby-theme] {
  border-color: var(--hb-line);
}

.hb-template[data-hobby-theme].selected {
  border-color: var(--hb-green);
  background: var(--hb-soft);
}

@media (max-width: 560px) {
  .hb-card-link {
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 12px;
  }

  .hb-card-garden-art {
    min-height: 122px;
  }

  .hb-card-plant {
    width: 78px;
    height: 78px;
  }
}


/* Phase A — consistent field styling and keyboard focus */
.hb-field input {
  box-sizing: border-box;
  width: 100%;
  min-height: 46px;
  padding: 0 14px;
  border: 1.5px solid #cfd9c6;
  border-radius: 12px;
  font: 500 16px 'DM Sans', sans-serif;
  background: #fff;
  color: var(--hb-ink);
  min-width: 0;
}

.hb-field input:focus-visible,
.hb-field textarea:focus-visible,
.hb-field select:focus-visible {
  outline: 3px solid var(--hb-green);
  outline-offset: 2px;
}

.hb-session-sheet .hb-field input,
.hb-session-sheet .hb-field textarea {
  width: 100%;
  box-sizing: border-box;
}

.hb-undo-session-toast {
  z-index: 280;
}
