  color: #7e8b83;
  font: 600 19px/1.3 'Manrope', sans-serif;
}

.diary-paper-guidance {
  margin: 0 0 5px;
}

.diary-paper-prompt {
  margin: 0;
  color: #7b887e;
  font: italic 500 0.9rem/1.4 'Manrope', sans-serif;
}

.diary-starters {
  align-items: center;
  gap: 6px;
  margin-top: 5px;
}

.diary-starters-label {
  color: var(--diary-muted);
  font-size: 0.6875rem;
  font-weight: 600;
}

.diary-starters button {
  min-height: 29px;
  padding: 0 9px;
