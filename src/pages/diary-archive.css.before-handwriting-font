  justify-content: center;
  align-items: center;
  width: 31px;
  min-width: 31px;
  min-height: 30px;
  padding: 0;
  border-radius: 9px;
}

.diary-pager-button span {
  display: none;
}

.diary-pager .diary-back-button {
  min-height: 30px;
  margin-left: 5px;
  padding: 0 10px;
  font-size: 0.75rem;
}

.diary-paper.is-today .diary-paper-date {
