}

@media (max-width: 560px) {
  .diary-header {
    margin-bottom: 9px;
  }

  .diary-paper-prompt {
    font-size: 0.82rem;
  }

  .diary-starters {
    gap: 5px;
  }

  .diary-starters-label {
    font-size: 0.65rem;
  }

  .diary-starters button {
    min-height: 28px;
    padding: 0 8px;
    font-size: 0.65rem;
  }

  .diary-editor-toolbar {
    flex-wrap: nowrap;
    gap: 4px;
  }

  .diary-paper-moods .diary-mood-options {
    gap: 0;
  }

  .diary-paper-moods .diary-mood-button {
    width: 27px;
    min-width: 27px;
    min-height: 29px;
    padding: 0;
  }

  .diary-paper-moods .diary-mood-button svg {
    width: 19px;
    height: 19px;
  }

  .diary-toolbar-actions {
    gap: 5px;
  }

  .diary-word-count {
    font-size: 0.65rem;
  }

  .diary-editor-toolbar .diary-dictation-button {
    min-height: 32px;
    padding: 0 9px;
    font-size: 0.75rem;
  }
}

@media (max-width: 360px) {
  .diary-word-count {
    display: none;
  }

  .diary-paper-moods .diary-mood-button {
    width: 25px;
    min-width: 25px;
  }
}


/* Interactive diary prompt */
button.diary-paper-prompt {
  display: block;
  width: fit-content;
  max-width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
  transition: color 0.15s ease;
}

button.diary-paper-prompt:hover {
  color: var(--diary-accent);
}

button.diary-paper-prompt:focus-visible {
  outline: 2px solid rgba(47, 90, 67, 0.45);
  outline-offset: 3px;
  border-radius: 4px;
}


/* Monthly calendar summary */
.diary-month-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 5px 10px;
  margin-top: 13px;
  padding-top: 11px;
  border-top: 1px solid var(--diary-line);
  color: var(--diary-muted);
  font-size: 0.75rem;
  line-height: 1.5;
}

.diary-month-summary > strong {
  color: var(--diary-accent);
  font-size: 0.8125rem;
  font-weight: 750;
}

.diary-month-summary b {
  color: var(--diary-accent);
  font-weight: 700;
}

.diary-mini-day.is-selected::after,
.diary-mini-day.is-today::after {
  display: none;
}


/* Diary visual hierarchy refinements */
.diary-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.diary-title-row h1 {
  margin: 0;
}

.diary-heading-copy .diary-pager {
  align-self: center;
  margin: 0;
}

.diary-paper.is-today .diary-paper-date {
  margin-bottom: 3px;
  color: #40527b;
  font: 700 23px/1.3 'Caveat', 'Segoe Script', cursive;
}

.diary-paper-prompt {
  color: #8a9684;
  font: italic 500 0.9rem/1.4 'Manrope', sans-serif;
}

.diary-paper-moods {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
}

.diary-mood-label {
  color: #8a9684;
  font-size: 0.6875rem;
  font-weight: 650;
}

.diary-paper {
  padding-left: 72px;
}

@media (max-width: 560px) {
  .diary-paper {
    padding-left: 52px;
  }

  .diary-title-row {
    gap: 7px;
  }

  .diary-paper.is-today .diary-paper-date {
    font-size: 21px;
  }
}

/* Ruled paper and bottom writing toolbar */


/* Ruled paper and bottom writing toolbar */
.diary-paper {
  --line: 34px;
  --top: 8px;

  padding: var(--top) 24px 0 68px;
  background-color: #fffdf7;
  background-image:
    radial-gradient(circle at 25px 50%, #d9d2bd 0 4px, transparent 4.8px),
    linear-gradient(90deg, transparent 52px, #efb2aa 52px 54px, transparent 54px),
    linear-gradient(transparent calc(var(--line) - 1px), #d5e0eb calc(var(--line) - 1px));
  background-size:
    100% calc(var(--line) * 2),
    100% 100%,
    calc(100% - 54px) var(--line);
  background-position: 0 var(--top), 0 0, 54px var(--top);
  background-repeat: repeat-y, no-repeat, repeat-y;
}

.diary-paper .diary-paper-date,
.diary-paper.is-today .diary-paper-date {
  height: var(--line);
  margin: 0;
  color: #40527b;
  font: 700 25px/var(--line) 'Caveat', 'Segoe Script', cursive;
}

button.diary-paper-prompt {
  display: block;
  width: 100%;
  height: var(--line);
  overflow: hidden;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8a9684;
  font: italic 500 0.875rem/var(--line) 'Manrope', sans-serif;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
}

button.diary-paper-prompt:hover {
  color: var(--diary-accent);
}

button.diary-paper-prompt:focus-visible {
  outline: 2px solid rgba(47, 90, 67, 0.4);
  outline-offset: -2px;
}

.diary-starters {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 7px;
  width: 100%;
  height: var(--line);
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  transition: opacity 0.2s ease;
}

.diary-starters::-webkit-scrollbar {
  display: none;
}

.diary-starters .diary-starters-label {
  flex: none;
  margin-right: 2px;
  color: #98a294;
  font-size: 0.6875rem;
}

.diary-starters button {
  flex: none;
  min-height: 26px;
}

.diary-starters.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.diary-paper textarea {
  display: block;
  width: 100%;
  height: calc(var(--line) * 9);
  min-height: calc(var(--line) * 9);
  padding: 0;
  border: 0;
  border-radius: 0;
  outline: 0;
  resize: none;
  overflow: hidden;
  background: transparent;
  background-image: none;
  background-attachment: initial;
  color: #344568;
  font: 500 23px/var(--line) 'Caveat', 'Segoe Script', cursive;
  caret-color: #40527b;
}

.diary-paper textarea::placeholder {
  color: #a1abc0;
  opacity: 1;
}

.diary-paper.is-past textarea {
  height: auto;
  min-height: 0;
}

.diary-paper-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6px 16px;
  min-height: calc(var(--line) * 2);
  margin: 0 -24px 0 -14px;
  padding: 6px 24px 6px 14px;
  border-top: 1px solid rgba(47, 90, 67, 0.09);
  background: #fffdf7;
}

.diary-footer-mood,
.diary-footer-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
}

.diary-footer-mood .diary-tool-label {
  margin-right: 4px;
  color: #98a294;
  font-size: 0.6875rem;
  font-weight: 700;
}

.diary-paper-footer .diary-mood-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  min-width: 36px;
  min-height: 36px;
  padding: 6px;
  border-radius: 10px;
}

.diary-paper-footer .diary-mood-button svg {
  width: 20px;
  height: 20px;
}

.diary-footer-meta {
  justify-content: flex-end;
  gap: 12px;
  margin-left: auto;
}

.diary-paper-footer .diary-paper-status {
  margin: 0;
  color: #8d9488;
  font-size: 10px;
  font-weight: 600;
  text-align: right;
}

.diary-paper-footer .diary-speech-error {
  flex: 1 0 100%;
  margin: 0;
}

@media (max-width: 560px) {
  .diary-paper {
    padding: var(--top) 14px 0 48px;
    background-image:
      radial-gradient(circle at 17px 50%, #d9d2bd 0 3px, transparent 3.8px),
      linear-gradient(90deg, transparent 36px, #efb2aa 36px 38px, transparent 38px),
      linear-gradient(transparent calc(var(--line) - 1px), #d5e0eb calc(var(--line) - 1px));
    background-size:
      100% calc(var(--line) * 2),
      100% 100%,
      calc(100% - 38px) var(--line);
    background-position: 0 var(--top), 0 0, 38px var(--top);
  }

  .diary-paper textarea {
    height: calc(var(--line) * 7);
    min-height: calc(var(--line) * 7);
  }

  .diary-paper.is-past textarea {
    height: auto;
    min-height: 0;
  }

  .diary-paper-footer {
    margin: 0 -14px 0 -10px;
    padding: 6px 14px 6px 10px;
  }

  .diary-footer-mood {
    gap: 4px;
  }

  .diary-paper-footer .diary-mood-button {
    width: 32px;
    min-width: 32px;
    min-height: 32px;
    padding: 5px;
  }

  .diary-footer-meta {
    width: 100%;
    justify-content: space-between;
    gap: 7px;
  }

  .diary-paper-footer .diary-paper-status {
    font-size: 9px;
  }
}
