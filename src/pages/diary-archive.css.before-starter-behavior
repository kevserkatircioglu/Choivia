/* Diary archive additions. Import AFTER diary.css so these rules win. */

:root {
  --diary-accent: #2f5a43;
  --diary-accent-soft: #eef4ea;
  --diary-muted: #6b7f72;
  --diary-line: rgba(47, 90, 67, 0.14);
}

/* ---------- header ---------- */

.diary-relative {
  margin: 2px 0 0;
  color: var(--diary-muted);
  font-size: 0.9375rem;
}

/* ---------- pager ---------- */

.diary-pager {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin: 0 0 14px;
}

.diary-pager-button {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 40px;
  padding: 0 14px;
  border: 1px solid var(--diary-line);
  border-radius: 999px;
  background: #fff;
  color: var(--diary-accent);
  font: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, opacity 0.15s ease;
}

.diary-pager-button:hover:not(:disabled) {
  background: var(--diary-accent-soft);
}

.diary-pager-button:disabled {
  opacity: 0.4;
  cursor: default;
}

.diary-pager .diary-back-button {
  margin: 0 0 0 auto;
}

/* ---------- paper ---------- */

/* Pages grow with their text; the resize grip would break the notebook look. */
.diary-paper textarea {
  resize: none;
  overflow: hidden;
}

/* Past pages: slightly warmer, muted ribbon, no text cursor. */
.diary-paper.is-past {
  filter: sepia(0.12) saturate(0.92) brightness(0.985);
}

.diary-paper.is-past .diary-ribbon {
  opacity: 0.45;
  filter: grayscale(0.6);
}

.diary-paper.is-readonly textarea {
  cursor: default;
}

/* Page change: short fade + slide. */
.diary-paper.is-entering {
  animation: diary-page-in 0.18s ease-out;
}

@keyframes diary-page-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .diary-paper.is-entering {
    animation: none;
  }
}

/* ---------- archive layout ---------- */

.diary-archive {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 20px;
  align-items: start;
  margin-top: 20px;
}

@media (max-width: 760px) {
  .diary-archive {
    grid-template-columns: 1fr;
  }
}

/* ---------- mini calendar ---------- */

.diary-mini,
.diary-archive-list {
  padding: 16px 18px;
  border: 1px solid var(--diary-line);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.92);
}

.diary-mini header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}

.diary-mini h2 {
  margin: 0;
  color: var(--diary-accent);
  font-size: 0.9375rem;
  font-weight: 700;
}

.diary-mini header button {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--diary-accent);
  cursor: pointer;
}

.diary-mini header button:hover:not(:disabled) {
  background: var(--diary-accent-soft);
}

.diary-mini header button:disabled {
  opacity: 0.3;
  cursor: default;
}

.diary-mini-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  justify-items: center;
}

.diary-mini-weekday {
  color: var(--diary-muted);
  font-size: 0.6875rem;
  font-weight: 700;
}

.diary-mini-day {
  position: relative;
  width: 100%;
  max-width: 34px;
  aspect-ratio: 1;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: rgba(39, 65, 47, 0.35);
  font: inherit;
  font-size: 0.8125rem;
  cursor: default;
}

.diary-mini-day:not(:disabled) {
  color: #27412f;
  font-weight: 700;
  cursor: pointer;
}

.diary-mini-day:not(:disabled):hover {
  background: var(--diary-accent-soft);
}

.diary-mini-day.has-entry::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 3px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
  transform: translateX(-50%);
  opacity: 0.7;
}

.diary-mini-day.is-today {
  box-shadow: inset 0 0 0 1.5px var(--diary-accent);
}

.diary-mini-day.is-selected {
  background: var(--diary-accent);
  color: #fff;
}

/* ---------- list ---------- */

.diary-archive-list h2 {
  margin: 0 0 6px;
  font-size: 1.05rem;
}

.diary-month + .diary-month {
  border-top: 1px solid var(--diary-line);
}

.diary-month-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  min-height: 44px;
  padding: 8px 4px;
  border: 0;
  background: none;
  color: var(--diary-accent);
  font: inherit;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}

.diary-month-toggle em {
  margin-left: auto;
  color: var(--diary-muted);
  font-size: 0.8125rem;
  font-style: normal;
  font-weight: 500;
}

.diary-month-toggle svg {
  transition: transform 0.15s ease;
}

.diary-month-toggle[aria-expanded='false'] svg {
  transform: rotate(-90deg);
}

.diary-month ul {
  display: grid;
  gap: 6px;
  margin: 0 0 10px;
  padding: 0;
  list-style: none;
}

.diary-archive-row {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 52px;
  padding: 8px 12px;
  border: 0;
  border-radius: 14px;
  background: #f4f7f0;
  color: #27412f;
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s ease;
}

.diary-archive-row:hover {
  background: #e9f0e0;
}

.diary-archive-row.is-active {
  background: #dfeac9;
  box-shadow: inset 0 0 0 1.5px var(--diary-accent);
}

.diary-archive-date {
  display: grid;
  justify-items: center;
  line-height: 1.1;
}

.diary-archive-date small {
  color: var(--diary-muted);
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
}

.diary-archive-date b {
  font-size: 1.125rem;
}

.diary-archive-preview {
  overflow: hidden;
  font-size: 0.9375rem;
  font-style: italic;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diary-archive-meta {
  color: var(--diary-muted);
  font-size: 0.75rem;
  white-space: nowrap;
}

@media (max-width: 480px) {
  .diary-archive-row {
    grid-template-columns: 44px minmax(0, 1fr);
  }

  .diary-archive-meta {
    display: none;
  }
}

/* ---------- shared mood colours ---------- */

:root {
  --mood-great: #3f8f5a;
  --mood-good: #7fa85f;
  --mood-okay: #b9a13f;
  --mood-low: #cf8a52;
  --mood-tough: #c56a62;
}

.mood-icon.mood-great { color: var(--mood-great); }
.mood-icon.mood-good { color: var(--mood-good); }
.mood-icon.mood-okay { color: var(--mood-okay); }
.mood-icon.mood-low { color: var(--mood-low); }
.mood-icon.mood-tough { color: var(--mood-tough); }

.diary-mood-button svg {
  opacity: 0.75;
  transition: opacity 0.15s ease;
}

.diary-mood-button:hover svg,
.diary-mood-button.is-selected svg {
  opacity: 1;
}

.diary-mini-day.has-entry::after {
  width: 6px;
  height: 6px;
  bottom: 2px;
  opacity: 1;
}

.diary-mini-day.mood-great::after { background: var(--mood-great); }
.diary-mini-day.mood-good::after { background: var(--mood-good); }
.diary-mini-day.mood-okay::after { background: var(--mood-okay); }
.diary-mini-day.mood-low::after { background: var(--mood-low); }
.diary-mini-day.mood-tough::after { background: var(--mood-tough); }

.diary-mini-day.is-selected::after {
  box-shadow: 0 0 0 1px #fff;
}


/* ---------- diary backup and empty state ---------- */

.diary-empty {
  margin: 20px 0 0;
  padding: 16px 18px;
  border: 1px dashed var(--diary-line);
  border-radius: 16px;
  color: var(--diary-muted);
  font-size: 0.875rem;
  line-height: 1.6;
  text-align: center;
}

.diary-backup {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 20px;
  margin-top: 20px;
  padding: 15px 18px;
  border: 1px solid var(--diary-line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.78);
}

.diary-backup-copy {
  flex: 1 1 230px;
}

.diary-backup h2 {
  margin: 0 0 4px;
  color: var(--diary-accent);
  font: 700 0.9375rem 'Manrope', sans-serif;
}

.diary-backup p {
  max-width: 460px;
  margin: 0;
  color: var(--diary-muted);
  font-size: 0.75rem;
  line-height: 1.55;
}

.diary-backup-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.diary-backup-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 38px;
  padding: 0 13px;
  border: 1px solid var(--diary-line);
  border-radius: 999px;
  background: #fff;
  color: var(--diary-accent);
  font: inherit;
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
}

.diary-backup-actions button:hover {
  background: var(--diary-accent-soft);
}

.diary-backup .diary-backup-message {
  flex-basis: 100%;
  max-width: none;
  color: var(--diary-accent);
  font-weight: 600;
}

/* Past pages should fit their content rather than keeping a large blank sheet. */
.diary-paper textarea {
  min-height: 34dvh;
}

.diary-paper.is-past textarea {
  min-height: 0;
}

@media (max-width: 560px) {
  .diary-backup {
    align-items: stretch;
    flex-direction: column;
  }

  .diary-backup-actions {
    width: 100%;
  }

  .diary-backup-actions button {
    flex: 1 1 auto;
  }

  .diary-paper textarea {
    min-height: 30dvh;
  }

  .diary-paper.is-past textarea {
    min-height: 0;
  }
}


/* Diary writing-first layout */
.diary-header {
  align-items: flex-start;
  margin-bottom: 11px;
}

.diary-heading-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.diary-pager {
  align-self: flex-start;
  gap: 5px;
  margin: 6px 0 0;
}

.diary-pager-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 31px;
  min-width: 31px;
  min-height: 30px;
  padding: 0;
  border-radius: 9px;
}

.diary-pager-button span {
  display: none;
}

.diary-pager .diary-back-button {
  min-height: 30px;
  margin-left: 5px;
  padding: 0 10px;
  font-size: 0.75rem;
}

.diary-paper.is-today .diary-paper-date {
  margin-bottom: 3px;
  color: #7e8b83;
  font: 600 19px/1.3 'Manrope', sans-serif;
}

.diary-paper-guidance {
  margin: 0 0 5px;
}

.diary-paper-prompt {
  margin: 0;
  color: #7b887e;
  font: italic 500 0.9rem/1.4 'Manrope', sans-serif;
}

.diary-starters {
  align-items: center;
  gap: 6px;
  margin-top: 5px;
}

.diary-starters-label {
  color: var(--diary-muted);
  font-size: 0.6875rem;
  font-weight: 600;
}

.diary-starters button {
  min-height: 29px;
  padding: 0 9px;
  font-size: 0.6875rem;
}

.diary-editor-toolbar {
  align-items: center;
  gap: 8px;
  min-height: 32px;
  margin: 7px 0;
}

.diary-paper-moods .diary-mood-options {
  gap: 2px;
}

.diary-paper-moods .diary-mood-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  min-width: 32px;
  min-height: 32px;
  padding: 2px;
  border-radius: 9px;
}

.diary-paper-moods .diary-mood-button small {
  display: none;
}

.diary-paper-moods .diary-mood-button svg {
  width: 21px;
  height: 21px;
}

.diary-toolbar-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  min-width: 0;
  margin-left: auto;
}

.diary-editor-toolbar .diary-past-mood {
  min-height: 30px;
  padding: 4px 9px;
  font-size: 0.75rem;
}

@media (max-width: 560px) {
  .diary-header {
    margin-bottom: 9px;
  }

  .diary-paper-prompt {
    font-size: 0.82rem;
  }

  .diary-starters {
    gap: 5px;
  }

  .diary-starters-label {
    font-size: 0.65rem;
  }

  .diary-starters button {
    min-height: 28px;
    padding: 0 8px;
    font-size: 0.65rem;
  }

  .diary-editor-toolbar {
    flex-wrap: nowrap;
    gap: 4px;
  }

  .diary-paper-moods .diary-mood-options {
    gap: 0;
  }

  .diary-paper-moods .diary-mood-button {
    width: 27px;
    min-width: 27px;
    min-height: 29px;
    padding: 0;
  }

  .diary-paper-moods .diary-mood-button svg {
    width: 19px;
    height: 19px;
  }

  .diary-toolbar-actions {
    gap: 5px;
  }

  .diary-word-count {
    font-size: 0.65rem;
  }

  .diary-editor-toolbar .diary-dictation-button {
    min-height: 32px;
    padding: 0 9px;
    font-size: 0.75rem;
  }
}

@media (max-width: 360px) {
  .diary-word-count {
    display: none;
  }

  .diary-paper-moods .diary-mood-button {
    width: 25px;
    min-width: 25px;
  }
}
